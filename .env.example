# OpenRouter-style multi-model LLM (required for live agent runs)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Pluggable model id (OpenRouter format)
# For published free-model scores, pin a concrete free id (avoid openrouter/free router):
# MODEL=nex-agi/nex-n2.5-pro:free
# Backup: nvidia/nemotron-3.5-lightning:free
MODEL=openai/gpt-4o-mini

# Optional: override API base (default https://openrouter.ai/api/v1)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
